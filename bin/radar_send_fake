#!/usr/bin/python3
"""Read fake speed values from log file, and send to MQTT server"""
# Works with the fake_buttons program that writes the log file
# pylint: disable=C0103                 # It thinks that my config defaults are Constants
# pylint: disable=superfluous-parens    # I like the parens
# pylint: disable=unspecified-encoding  # This software requires Pi hardware
#

import sys
import os
import io
import asyncio
import time
import getopt
from functools import partial
from typing import AsyncIterator
import ssl
import paho.mqtt.client as mqtt
import yaml

# default files
mqtt_config_file="/etc/radar_mqtt/radar_mqtt.conf"

# default mqtt values
mqtt_clientname = "Radar_Fake_Sender"
mqtt_topic = "radar/#"
mqtt_server = "www.dd.id.au"
mqtt_port = 443
mqtt_tls = False  # will be overidden based on port below
mqtt_transport = "websockets"
mqtt_user = "test_recv"         # This should come from the config file
mqtt_pass = "default_password"
mqtt_path_base = "/mqtt"

verbose=0
argv = sys.argv[1:]

try:
    opts, args = getopt.getopt(argv, "c:v", ["config ="])
except getopt.GetoptError as err:
    print('Bad arguments: ' + str(err), file=sys.stderr)
    sys.exit(1)

# First pass of the options
for opt, arg in opts:
    if opt in ['-c', '--config']:
        mqtt_config_file = arg
    elif opt == '-v':
        verbose = verbose + 1

# Read in the mqtt config file
if os.path.isfile(mqtt_config_file):
    with open(mqtt_config_file) as conf_file:
        config=yaml.safe_load(conf_file)
        if (verbose > 0):
            print(yaml.dump(config))
else:
    print('Radar MQTT config file does not exist: ' + mqtt_config_file, file=sys.stderr)
    sys.exit(1)

if 'debug' in config :
    verbose = config['debug']
if 'mqtt_clientname' in config :
    mqtt_clientname = config['mqtt_clientname'] + "_Fake_Sender"
if 'mqtt_topic' in config :
    mqtt_topic = config['mqtt_topic']
if 'mqtt_server' in config :
    mqtt_server = config['mqtt_server']
if 'mqtt_port' in config :
    mqtt_port = config['mqtt_port']
if mqtt_port == 443 :
    mqtt_tls = True
elif mqtt_port == 8883 :
    mqtt_tls = True
elif mqtt_port == 8081 :
    mqtt_tls = True
if 'mqtt_tls' in config :
    mqtt_tls = config['mqtt_tls']
if 'mqtt_transport' in config :
    mqtt_transport = config['mqtt_transport']
if 'mqtt_user' in config :
    mqtt_user = config['mqtt_user']
if 'mqtt_pass' in config :
    mqtt_pass = config['mqtt_pass']
if 'mqtt_path_base' in config :
    mqtt_path_base = config['mqtt_path_base']


LINE_BUFFER = 1

async def tail(
    filename: str,
    last_lines: int = 10,
    non_exist_max_secs: float = 30.0,
    fp_poll_secs: float = 0.125
) -> AsyncIterator[str]:
    """Continuously tail a file pointer yielding one line at a time."""

    async def wait_exists() -> bool:
        """Wait for a file to exist, the return statement reflects
        whether or not the file existed when the timeout limits were reached."""
        bail_at: float = time.monotonic() + non_exist_max_secs
        while not os.path.exists(filename):
            if time.monotonic() >= bail_at:
                return False
            await asyncio.sleep(fp_poll_secs)
        return True

    async def check_rotate(_fp) -> io.TextIOBase:
        """Determine if the file rotated in place; same name different inode."""
        nonlocal fino
        if os.stat(filename).st_ino != fino:
            new_fp = open(filename, 'r')
            _fp.close()
            new_fp.seek(0, os.SEEK_SET)
            fino = os.fstat(new_fp.fileno()).st_ino
            return new_fp
        return _fp

    # ~~
    if not await wait_exists():
        return

    buff = io.StringIO()
    stat = os.stat(filename)

    fino: int = stat.st_ino
    size: int = stat.st_size
    blocksize: int = os.statvfs(filename).f_bsize

    fp = open(filename, 'r', LINE_BUFFER)

    if last_lines > 0:
        if stat.st_size <= blocksize:
            # if the file is smaller than 8kb, read all the lines
            for line in fp.readlines()[-last_lines::]:
                yield line.rstrip()
        else:
            # if the file is larger than 8kb, seek 8kb from the end
            #  and return all the lines except the (potential) half-line
            # first element and the null-terminated extra line at the end.
            fp.seek(os.stat(fp.fileno()).st_size - blocksize)
            for line in fp.readlines()[1:-1][-last_lines::]:
                yield line.rstrip()

    # seek to the end of the file for tailing
    #  given the above operations we should already be there.
    fp.seek(0, os.SEEK_END)

    try:
        while True:
            # wait for the file to exist -- generously
            if not os.path.exists(filename):
                if not await wait_exists():
                    return

            fp = await check_rotate(fp)
            n_stat = os.fstat(fp.fileno())
            n_size = n_stat.st_size

            # if the file is the same size, churn
            #  .. this could be error-prone on small files that
            # rotate VERY fast, but that's an edge case for
            #  tailing a persistent log file.
            if n_size == size:
                await asyncio.sleep(fp_poll_secs)
                continue

            # if the file shrank, seek to the beginning
            if n_size < size:
                fp.seek(0, os.SEEK_SET)

            size = n_size
            for chunk in iter(partial(fp.read, blocksize), ''):
                buff.write(chunk)

            buff.seek(0, os.SEEK_SET)

            for line in buff.readlines():
                yield line.rstrip()

            # resize our string buffer
            buff.seek(0, os.SEEK_SET)
            buff.truncate(0)

    except IOError:
        buff.close()
        fp.close()


if __name__ == '__main__':

    async def main():
        """Continuously read the log file, and send to MQTT"""
        async for line in tail(r'/var/log/radar/radar1'):
            print(len(line), " : ", line)
            mqttc.publish(mqtt_topic, line, 1)

    try:
        #mqttc=mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, "Radar_Sender", transport="websockets")
        mqttc = mqtt.Client(mqtt_clientname, transport=mqtt_transport)
        mqttc.tls_set(cert_reqs=ssl.CERT_REQUIRED, tls_version=ssl.PROTOCOL_TLSv1_2)

        mqttc.ws_set_options(path=mqtt_path_base)

        mqttc.username_pw_set(mqtt_user, mqtt_pass)

        mqttc.connect(mqtt_server, mqtt_port)

        mqttc.loop_start()

        loop = asyncio.new_event_loop()
        loop.run_until_complete(main())
    except KeyboardInterrupt:
        pass
    loop.stop()
    loop.close()
